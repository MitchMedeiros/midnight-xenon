{
  "name": "midnight-xenon",
  "displayName": "Midnight Xenon Theme",
  "description": "A minimalistic Dark Modern alternative with a blue UI and consistent syntax highlighting across 20+ languages.",
  "author": {
    "name": "Mitchell Medeiros"
  },
  "publisher": "MitchellMedeiros",
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#181b20",
    "theme": "dark"
  },
  "license": "MIT",
  "version": "1.6.3",
  "engines": {
    "vscode": "^1.12.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "modern dark",
    "modern",
    "xenon",
    "minimalistic",
    "syntax",
    "highlighting",
    "syntax highlighting",
    "dark theme",
    "color theme",
    "dark modern",
    "dark+",
    "blue",
    "semantic highlighting",
    "vscodium",
    "python",
    "java",
    "scala",
    "javascript",
    "typescript",
    "rust",
    "go",
    "kotlin",
    "swift",
    "php",
    "ruby",
    "c++",
    "csharp"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Midnight Xenon",
        "uiTheme": "vs-dark",
        "path": "./themes/midnight-xenon-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MitchMedeiros/midnight-xenon.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:theme": "node tools/check-theme.mjs",
    "tokens": "node tools/token-check.mjs",
    "check": "npm run format:check && npm run check:theme",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0"
  }
}
