{
  "name": "midnight-xenon",
  "displayName": "Midnight Xenon Theme",
  "description": "A minimalistic theme with consistent syntax highlighting inspired by Dark Modern.",
  "author": {
    "name": "Mitchell Medeiros"
  },
  "publisher": "MitchellMedeiros",
  "icon": "assets/logo.png",
  "license": "MIT",
  "version": "1.5.1",
  "engines": {
    "vscode": "^1.12.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "modern dark",
    "modern",
    "xenon",
    "minimalistic",
    "syntax",
    "highlighting",
    "syntax highlighting"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Midnight Xenon",
        "uiTheme": "vs-dark",
        "path": "./themes/midnight-xenon-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MitchMedeiros/midnight-xenon.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:theme": "node tools/check-theme.mjs",
    "check": "npm run format:check && npm run check:theme",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
